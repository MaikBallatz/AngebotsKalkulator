<div class="flex items-center justify-between mb-6">
  <h1 class="text-2xl font-bold text-ink">Berater:innen</h1>
  <%= link_to "Berater:in hinzufügen", new_consultant_path, class: "bg-brand-600 hover:bg-brand-700 text-brand-ink font-medium py-2 px-4 rounded-control" %>
</div>

<div class="bg-surface rounded-card shadow p-6">
  <table class="w-full">
    <thead>
      <tr>
        <th class="text-left text-xs font-medium text-ink-muted uppercase tracking-wider px-4 py-3">Name</th>
        <th class="text-left text-xs font-medium text-ink-muted uppercase tracking-wider px-4 py-3">E-Mail</th>
        <th class="text-left text-xs font-medium text-ink-muted uppercase tracking-wider px-4 py-3">Status</th>
        <th class="text-left text-xs font-medium text-ink-muted uppercase tracking-wider px-4 py-3"></th>
      </tr>
    </thead>
    <tbody>
      <% @consultants.each do |consultant| %>
        <tr class="hover:bg-page border-b border-line">
          <td class="px-4 py-3 text-sm text-ink"><%= consultant.name %></td>
          <td class="px-4 py-3 text-sm text-ink"><%= consultant.email %></td>
          <td class="px-4 py-3 text-sm text-ink">
            <% if consultant.active? %>
              <span class="inline-flex items-center rounded-control bg-green-50 text-green-700 text-xs font-medium px-2 py-1">Aktiv</span>
            <% else %>
              <span class="inline-flex items-center rounded-control bg-muted text-ink-soft text-xs font-medium px-2 py-1">Inaktiv</span>
            <% end %>
          </td>
          <td class="px-4 py-3 text-sm text-right">
            <% if consultant.active? %>
              <%= button_to "Deaktivieren", deactivate_consultant_path(consultant), method: :patch,
                    form: { data: { turbo_confirm: "#{consultant.name} deaktivieren?" } },
                    class: "text-sm text-red-600 hover:text-red-700 underline underline-offset-2 cursor-pointer" %>
            <% end %>
          </td>
        </tr>
      <% end %>
    </tbody>
  </table>
</div>
