<!DOCTYPE html>
<html>
  <head>
    <title><%= content_for(:title) || "Angebots Pilot" %></title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <meta name="apple-mobile-web-app-capable" content="yes">
    <meta name="application-name" content="Angebots Pilot">
    <meta name="mobile-web-app-capable" content="yes">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>

    <%= yield :head %>

    <%# Enable PWA manifest for installable apps (make sure to enable in config/routes.rb too!) %>
    <%#= tag.link rel: "manifest", href: pwa_manifest_path(format: :json) %>

    <link rel="icon" href="/icon.png" type="image/png">
    <link rel="icon" href="/icon.svg" type="image/svg+xml">
    <link rel="apple-touch-icon" href="/icon.png">

    <%# Includes all stylesheet files in app/assets/stylesheets %>
    <%= stylesheet_link_tag :app, "data-turbo-track": "reload" %>
    <%= stylesheet_link_tag "tailwind", "data-turbo-track": "reload" %>
  </head>

  <body class="min-h-screen bg-page text-ink font-sans">
    <nav class="bg-surface border-b border-line">
      <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
        <div class="flex justify-between h-16 items-center">
          <div class="flex items-center gap-6">
            <%= link_to "AngebotsPilot", root_path, class: "text-xl font-bold text-ink" %>
            <%= link_to "Angebote", quotes_path, class: "text-sm px-3 py-2 rounded-control #{current_page?(quotes_path) ? "bg-muted text-ink font-medium" : "text-ink-soft hover:bg-muted hover:text-ink"}" %>
            <%= link_to "Berater:innen", consultants_path, class: "text-sm px-3 py-2 rounded-control #{current_page?(consultants_path) ? "bg-muted text-ink font-medium" : "text-ink-soft hover:bg-muted hover:text-ink"}" %>
          </div>
        </div>
      </div>
    </nav>

    <% if notice %>
      <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 mt-4">
        <div class="bg-green-50 border border-green-200 text-green-800 rounded-control p-4 text-sm">
          <%= notice %>
        </div>
      </div>
    <% end %>

    <% if alert %>
      <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 mt-4">
        <div class="bg-red-50 border border-red-200 text-red-800 rounded-control p-4 text-sm">
          <%= alert %>
        </div>
      </div>
    <% end %>

    <main class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-8">
      <%= yield %>
    </main>

    <%# Nachschlagen, nicht Navigation: die beiden Referenzseiten gehören nicht in die
        Kopfzeile, die der Kunde in der Demo sieht — aber auffindbar müssen sie sein. %>
    <footer class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-8 text-sm text-ink-muted">
      Nachschlagen:
      <%= link_to "Der Hauptweg", "/flow", class: "text-brand-600 hover:text-brand-700 underline underline-offset-2" %>
      ·
      <%= link_to "Der Baukasten", "/design", class: "text-brand-600 hover:text-brand-700 underline underline-offset-2" %>
    </footer>
  </body>
</html>
