<%= render "shared/back_link", path: quotes_path %>

<div class="bg-surface rounded-card shadow p-6">
  <div class="flex items-center justify-between mb-6">
    <h1 class="text-2xl font-bold text-ink"><%= @quote.company_name %></h1>
    <div class="flex gap-2">
      <%= button_to "Word-Dokument per E-Mail versenden", deliver_word_quote_path(@quote), method: :post,
            class: "bg-brand-600 hover:bg-brand-700 text-brand-ink font-medium py-2 px-4 rounded-control" %>
      <%= link_to "Geprüftes Word hochladen", upload_quote_path(@quote),
            class: "border border-line-strong hover:bg-muted text-ink-soft font-medium py-2 px-4 rounded-control" %>
    </div>
  </div>

  <div class="grid grid-cols-1 md:grid-cols-2 gap-x-10 gap-y-5">
    <div>
      <p class="text-sm text-ink-muted">Angebotstyp</p>
      <p class="text-sm text-ink mt-1"><%= @quote.angebotstyp %></p>
    </div>
    <div>
      <p class="text-sm text-ink-muted">Berater:in</p>
      <p class="text-sm text-ink mt-1"><%= @quote.consultant.name %></p>
    </div>
    <div>
      <p class="text-sm text-ink-muted">Ansprechpartner</p>
      <p class="text-sm text-ink mt-1"><%= @quote.contact_person %></p>
    </div>
    <div>
      <p class="text-sm text-ink-muted">Adresse</p>
      <p class="text-sm text-ink mt-1 whitespace-pre-line"><%= @quote.address %></p>
    </div>
    <div>
      <p class="text-sm text-ink-muted">Telefon</p>
      <p class="text-sm text-ink mt-1"><%= @quote.phone %></p>
    </div>
    <div>
      <p class="text-sm text-ink-muted">Gesuchte Position</p>
      <p class="text-sm text-ink mt-1"><%= @quote.position %></p>
    </div>
    <div>
      <p class="text-sm text-ink-muted">Projekt-Kennziffer</p>
      <p class="text-sm text-ink mt-1"><%= @quote.project_reference %></p>
    </div>
    <div>
      <p class="text-sm text-ink-muted">Mindesthonorar</p>
      <p class="text-sm text-ink mt-1">€ <%= @quote.minimum_fee %></p>
    </div>
    <div>
      <p class="text-sm text-ink-muted">Honorarsatz</p>
      <p class="text-sm text-ink mt-1"><%= @quote.fee_rate_is_third? ? "ein Drittel" : "#{@quote.fee_rate_percentage} %" %></p>
    </div>
    <div>
      <p class="text-sm text-ink-muted">Zahlungsziel</p>
      <p class="text-sm text-ink mt-1"><%= @quote.payment_term_days %> Tage</p>
    </div>
    <% if @quote.volumelimit? %>
      <div>
        <p class="text-sm text-ink-muted">Volumen-Limit</p>
        <p class="text-sm text-ink mt-1"><%= @quote.volume_limit %> Zielpersonen</p>
      </div>
    <% end %>
  </div>
</div>
