<%= render "shared/back_link", path: consultants_path %>

<div class="bg-surface rounded-card shadow p-6 max-w-lg">
  <h1 class="text-2xl font-bold text-ink mb-6">Berater:in hinzufügen</h1>

  <%= form_with model: @consultant, url: consultants_path do |f| %>
    <div class="mb-4">
      <%= f.label :name, "Name", class: "block text-sm font-medium text-ink-soft" %>
      <%= f.text_field :name, class: "block w-full rounded-control border border-line-strong px-3 py-2 shadow-sm focus:border-brand-600 focus:outline-none focus:ring-1 focus:ring-brand-600" %>
      <% @consultant.errors.full_messages_for(:name).each do |message| %>
        <p class="text-sm text-red-600 mt-1"><%= message %></p>
      <% end %>
    </div>

    <div class="mb-6">
      <%= f.label :email, "E-Mail", class: "block text-sm font-medium text-ink-soft" %>
      <%= f.email_field :email, class: "block w-full rounded-control border border-line-strong px-3 py-2 shadow-sm focus:border-brand-600 focus:outline-none focus:ring-1 focus:ring-brand-600" %>
      <% @consultant.errors.full_messages_for(:email).each do |message| %>
        <p class="text-sm text-red-600 mt-1"><%= message %></p>
      <% end %>
    </div>

    <%= f.submit "Hinzufügen", class: "bg-brand-600 hover:bg-brand-700 text-brand-ink font-medium py-2 px-4 rounded-control" %>
  <% end %>
</div>
