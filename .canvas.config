# Canvas / Dokku deployment target.
#
# EMPTY ON PURPOSE. Fill these in per hackathon, then commit.
# `bin/canvas` and the canvas skills read this file and nothing else —
# there is no fallback host. If CANVAS_HOST is empty, deployment stops
# with a clear message instead of pushing code somewhere unintended.
#
# Example:
#   CANVAS_USER="dokku"
#   CANVAS_HOST="dokku.example.com"
#   CANVAS_PORT="2222"
#   CANVAS_DOMAIN="apps.example.com"

CANVAS_USER="dokku"
CANVAS_HOST=""
CANVAS_PORT="2222"
CANVAS_DOMAIN=""
